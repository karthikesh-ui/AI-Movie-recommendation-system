GEMINI_API_KEY=your_gemini_api_key
# Optional; Model-B uses Gemini structured output and OMDb verification (no Google Search grounding).
GEMINI_MODEL=gemini-3.8-flash
OMDB_API_KEY=your_omdb_api_key
# Used by the separate A8 latest-discovery route only; Model-B does not use TMDB.
TMDB_API_READ_ACCESS_TOKEN=YOUR_TMDB_READ_ACCESS_TOKEN
FRONTEND_ORIGIN=http://localhost:5500
PORT=5000
WATCHMODE_API_KEY=your_watchmode_api_key
# Disabled by default: enabled discovery uses paid Watchmode catalog credits.
WATCHMODE_DISCOVERY_ENABLED=false
WATCHMODE_DISCOVERY_WINDOW_DAYS=90
# Used by /api/recommend-hybrid, not by Model-B movie search and similarity.
RECOMMENDATION_SOURCE=tmdb
